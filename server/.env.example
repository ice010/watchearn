PORT=4000
DB_PATH=./data/watchearn.db
KYC_DIR=./data/kyc
PUBLIC_URL=https://api.your-domain.com
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too

# Economics: 5 points per ad, 1000 points = $1 => $0.005 per ad.
# Keep POINTS_PER_AD / POINTS_PER_USD below your AdMob revenue per ad view.
POINTS_PER_AD=5
POINTS_PER_USD=1000
MIN_WITHDRAW_USD=5
MAX_ADS_PER_DAY=50

# true = simulated ads (web preview/dev). MUST be false in production (AdMob SSV credits rewards).
SANDBOX_REWARDS=true

# sandbox = simulate payouts; live = send real money.
PAYOUT_MODE=sandbox

# Verification codes: sandbox = logged + shown in the app; live = really sent
MESSAGING_MODE=sandbox
# Email codes via Resend (https://resend.com); EMAIL_FROM must be on a verified domain
RESEND_API_KEY=
EMAIL_FROM=WatchEarn <no-reply@your-domain.com>
# Phone codes via Twilio SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15550000000
TWILIO_WHATSAPP_FROM=+15550000000
# Approved WhatsApp "authentication" Content template with {{1}} = code
TWILIO_WHATSAPP_CONTENT_SID=

FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
