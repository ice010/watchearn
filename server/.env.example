PORT=4000
DB_PATH=./data/watchearn.db
PUBLIC_URL=https://api.your-domain.com
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too

# Economics: 5 points per ad, 1000 points = $1 => $0.005 per ad.
# Keep POINTS_PER_AD / POINTS_PER_USD below your AdMob revenue per ad view.
POINTS_PER_AD=5
POINTS_PER_USD=1000
MIN_WITHDRAW_USD=5
MAX_ADS_PER_DAY=50

# true = simulated ads (web preview/dev). MUST be false in production (AdMob SSV credits rewards).
SANDBOX_REWARDS=true

# sandbox = simulate payouts; live = send real money.
PAYOUT_MODE=sandbox
AUTO_APPROVE_WITHDRAWALS=false

FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
